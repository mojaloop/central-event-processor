{
  "name": "central-event-processor",
  "version": "12.2.7",
  "private": true,
  "description": "CEP for Mojaloop Central-Ledger to monitor the notification kafka topic and act on it",
  "homepage": "https://github.com/mojaloop/central-event-processor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojaloop/central-event-processor.git"
  },
  "bugs": {
    "url": "https://github.com/mojaloop/central-event-processor/issues"
  },
  "license": "Apache-2.0",
  "author": "ModusBox",
  "contributors": [
    "Valentin Genev <valentin.genev@modusbox.com>",
    "Miguel de Barros <miguel.debarros@modusbox.com>"
  ],
  "engines": {
    "node": "24.x"
  },
  "main": "src/index.js",
  "imports": {
    "#src/*": "./src/*.js"
  },
  "pre-commit": [
    "dep:check",
    "audit:check",
    "lint",
    "test"
  ],
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "npx tape 'test/unit/**/*.test.js' | tap-spec",
    "test:xunit": "npx tape 'test/unit/**/**.test.js' | tap-xunit > ./test/results/xunit.xml",
    "test:coverage": "npx nyc tapes -- 'test/unit/**/*.test.js' | tap-spec; nyc report ---reporter=text",
    "test:coverage-check": "npm run test:coverage && nyc check-coverage",
    "test:functional": "echo 'No functional tests defined'",
    "test:integration": "echo 'No integration tests defined'",
    "start": "node ./src/index.js",
    "standard": "npx standard",
    "standard:fix": "npx standard --fix",
    "lint": "npm run standard",
    "lint:fix": "npm run standard:fix",
    "dev": "npx nodemon ./src/index.js",
    "docker:up": "docker-compose -f docker-compose.yml up",
    "audit:check": "npx audit-ci --config ./audit-ci.jsonc",
    "audit:fix": "npm audit fix",
    "dep:check": "npx ncu -e 2",
    "dep:update": "npx ncu -u",
    "release": "npx standard-version --no-verify --releaseCommitMessageFormat 'chore(release): {{currentTag}} [skip ci]'",
    "snapshot": "npx standard-version --no-verify --skip.changelog --prerelease snapshot --releaseCommitMessageFormat 'chore(snapshot): {{currentTag}}'"
  },
  "dependencies": {
    "@mojaloop/central-services-error-handling": "13.2.0",
    "@mojaloop/central-services-health": "15.2.3",
    "@mojaloop/central-services-logger": "11.10.6",
    "@mojaloop/central-services-metrics": "12.8.8",
    "@mojaloop/central-services-shared": "18.39.3",
    "@mojaloop/central-services-stream": "11.10.0",
    "@mojaloop/event-sdk": "14.8.5",
    "@mojaloop/ml-number": "11.4.5",
    "axios": "1.20.0",
    "config": "5.0.1",
    "json-rules-engine": "7.3.1",
    "leaked-handles": "5.2.0",
    "moment": "2.31.0",
    "mongoose": "9.10.1",
    "mustache": "4.2.0",
    "rxjs": "7.8.2",
    "uuid4": "2.0.3"
  },
  "devDependencies": {
    "audit-ci": "^7.1.0",
    "mongodb-memory-server": "11.2.0",
    "nodemon": "3.1.14",
    "npm-check-updates": "23.1.0",
    "nyc": "^18.0.0",
    "pre-commit": "2.0.0",
    "proxyquire": "2.1.3",
    "replace": "^1.2.2",
    "rewire": "9.0.1",
    "sinon": "22.1.0",
    "standard": "17.1.2",
    "standard-version": "^9.5.0",
    "tap-spec": "^5.0.0",
    "tap-xunit": "2.4.1",
    "tape": "5.10.2",
    "tapes": "4.1.0"
  },
  "overrides": {
    "form-data": "4.0.6",
    "on-headers": "1.1.0",
    "async": "3.2.6",
    "postcss": "8.5.23",
    "shins": {
      "ajv": "6.12.3",
      "ejs": "3.1.10",
      "sanitize-html": "2.12.1",
      "jsonpointer": "5.0.0",
      "markdown-it": "14.2.0",
      "postcss": "8.5.10"
    },
    "widdershins": {
      "markdown-it": "14.2.0",
      "swagger2openapi": "7.0.8"
    },
    "markdown-it": "14.2.0",
    "trim": "0.0.3",
    "cross-spawn": "7.0.6",
    "tough-cookie": "4.1.3",
    "qs": "6.16.0",
    "js-yaml": "4.3.2",
    "fast-xml-parser": "5.10.1",
    "undici": "6.28.0",
    "lodash": "4.18.1",
    "axios": "1.20.0",
    "immutable": "5.1.8",
    "minimatch@3.0.5": "3.1.5",
    "yargs-parser@11.1.1": "13.1.2",
    "@grpc/grpc-js": "1.14.4",
    "convict": "6.2.5",
    "@mojaloop/event-sdk": {
      "protobufjs": "8.6.6"
    },
    "brace-expansion": "2.1.4",
    "browserslist": "4.28.7",
    "fast-uri": "3.1.6",
    "nanoid": "3.3.18",
    "sanitize-html": "2.17.7",
    "body-parser": "1.20.6",
    "mysql2": "3.23.1",
    "baseline-browser-mapping": "2.11.0",
    "joi": "18.2.5"
  },
  "standard-version": {
    "scripts": {
      "postchangelog": "replace '\\[mojaloop/#(\\d+)\\]\\(https://github.com/mojaloop/(.*)/issues/(\\d+)\\)' '[mojaloop/#$1](https://github.com/mojaloop/project/issues/$1)' CHANGELOG.md"
    }
  }
}
